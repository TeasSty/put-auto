---
const steps = [
  {
    code: '01 · BRIEF',
    title: 'Бриф и бюджет',
    text: 'Фиксируем модель, комплектацию, страну и потолок цены. Без «продадим что угодно».',
  },
  {
    code: '02 · LOT',
    title: 'Подбор лота',
    text: 'Смотрим аукционные листы, историю и реальные фото. Объясняем риски до ставки.',
  },
  {
    code: '03 · BID',
    title: 'Ставка на аукционе',
    text: 'Торгуемся в рамках согласованного лимита. Вы в курсе каждого шага.',
  },
  {
    code: '04 · ROUTE',
    title: 'Таможня и логистика',
    text: 'Смета под ключ заранее: доставка, пошлины, оформление. Без скрытых доплат после договора.',
  },
  {
    code: '05 · DETAIL',
    title: 'Подготовка к выдаче',
    text: 'При необходимости — детейлинг и финальная проверка перед передачей ключей.',
  },
  {
    code: '06 · KEYS',
    title: 'Выдача в Иркутске',
    text: 'Получаете автомобиль, документы и понятный итог сделки. Доставка в регионы — по согласованию.',
  },
];
---

<section class="section" id="path" aria-labelledby="path-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Маршрутный лист</p>
      <h2 id="path-title">Как устроен путь авто</h2>
      <p class="lede">Шесть контрольных точек — от заявки до ключей. Порядок важен: так вы всегда видите, на каком этапе машина.</p>
    </div>

    <div class="path-track reveal">
      {steps.map((step) => (
        <article class="path-step">
          <div class="path-step__code">{step.code}</div>
          <div>
            <h3 class="path-step__title">{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
