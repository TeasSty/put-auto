---
const services = [
  {
    title: 'Подбор под задачу',
    text: 'Семейный хэтчбек, гибрид, кроссовер или премиум — ищем конкретную комплектацию, а не «что попалось».',
    wide: false,
  },
  {
    title: 'Ставка и выкуп лота',
    text: 'Работаем с аукционами Японии, Кореи и Китая. Лимит ставки согласуем заранее.',
    wide: false,
  },
  {
    title: 'Таможня и доставка',
    text: 'Полный маршрут до Владивостока / Забайкальска и далее в Иркутск или ваш город. Стоимость услуг фиксируется в договоре.',
    wide: false,
  },
  {
    title: 'Детейлинг перед выдачей',
    text: 'Машина приходит чистой и готовой к осмотру — клиенты отмечают это в отзывах на Яндекс.Картах.',
    wide: false,
  },
  {
    title: 'Сопровождение сделки',
    text: 'Один канал связи, фотоотчёты, прозрачная смета. Менеджеры на связи на всём пути — от лота до ПТС.',
    wide: true,
  },
];
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Услуги</p>
      <h2 id="services-title">Единое окно: от аукциона до ключей</h2>
      <p class="lede">Не продаём «воздух». Закрываем весь цикл импорта — чтобы вы не собирали цепочку из пяти подрядчиков.</p>
    </div>

    <div class="services reveal">
      {services.map((s) => (
        <article class:list={['service', s.wide && 'service--wide']}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
