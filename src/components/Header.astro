---
const base = import.meta.env.BASE_URL;
const phoneDisplay = '+7 (950) 144-44-18';
const phoneHref = 'tel:+79501444418';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={`${base}#top`} aria-label="Путь Авто — на главную">
      <span class="brand__name">Путь Авто</span>
      <span class="brand__tag">JP · KR · CN → Иркутск</span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <a href={`${base}#path`}>Путь</a>
      <a href={`${base}#services`}>Услуги</a>
      <a href={`${base}#cases`}>Выдачи</a>
      <a href={`${base}#calc`}>Расчёт</a>
      <a href={`${base}#reviews`}>Отзывы</a>
      <a href={`${base}#contacts`}>Контакты</a>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={phoneHref}>{phoneDisplay}</a>
      <a class="btn" href={`${base}#calc`}>Рассчитать путь</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">
          Меню
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <div class="container mobile-nav__inner">
      <a href={`${base}#path`}>Путь</a>
      <a href={`${base}#services`}>Услуги</a>
      <a href={`${base}#cases`}>Выдачи</a>
      <a href={`${base}#calc`}>Расчёт</a>
      <a href={`${base}#reviews`}>Отзывы</a>
      <a href={`${base}#contacts`}>Контакты</a>
      <a href={phoneHref}>{phoneDisplay}</a>
      <a href="https://wa.me/79501444418" rel="noopener noreferrer" target="_blank">WhatsApp</a>
    </div>
  </div>
</header>
