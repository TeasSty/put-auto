---
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source srcset={`${base}images/hero-wide.webp`} type="image/webp" media="(min-width: 768px)" />
      <source srcset={`${base}images/hero-01.webp`} type="image/webp" />
      <img
        src={`${base}images/hero-01.jpg`}
        alt=""
        width="960"
        height="1280"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="hero__brand">Путь Авто</p>
    <h1 id="hero-title">Авто из Японии, Кореи и Китая — цена под ключ заранее</h1>
    <p class="lede">
      Подбираем лот, выигрываем аукцион, ведём таможню и логистику. Вы получаете понятную смету
      и машину без пробега по РФ — с выдачей в Иркутске.
    </p>
    <div class="hero__actions">
      <a class="btn" href={`${base}#calc`}>Рассчитать путь авто</a>
      <a class="btn btn--ghost" href="https://wa.me/79501444418?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!%20%D0%A5%D0%BE%D1%87%D1%83%20%D0%BF%D0%BE%D0%B4%D0%BE%D0%B1%D1%80%D0%B0%D1%82%D1%8C%20%D0%B0%D0%B2%D1%82%D0%BE%20%D0%BF%D0%BE%D0%B4%20%D0%B7%D0%B0%D0%BA%D0%B0%D0%B7." rel="noopener noreferrer" target="_blank">
        Написать в WhatsApp
      </a>
    </div>
    <div class="hero__meta">
      <div><strong>400+</strong> привезённых авто</div>
      <div><strong>5,0</strong> на Яндекс.Картах</div>
      <div><strong>договор</strong> и фикс услуг</div>
    </div>
  </div>
</section>
